text = "Reset to Default"
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("SBButtonNormal")
theme_override_styles/hover = SubResource("SBButtonHover")
theme_override_styles/pressed = SubResource("SBButtonPressed")
theme_override_styles/focus = SubResource("SBFocusBorder")

; ApplyButton - 应用按钮（收集设置→保存cfg→应用到引擎/单例→广播settings_applied信号）
[node name="ApplyButton" type="Button" parent="VBoxContainer/ButtonContainer"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 48)
text = "Apply"
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("SBButtonNormal")
theme_override_styles/hover = SubResource("SBButtonHover")
theme_override_styles/pressed = SubResource("SBButtonPressed")
theme_override_styles/focus = SubResource("SBFocusBorder")

; BottomSpacer - 界面底部收尾留白（固定24px，不做弹性填充）
[node name="BottomSpacer" type="Control" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 24)
mouse_filter = 2
