mouse_filter = 2

; MasterRow - 主音量行（标签 + 滑块 + 数值）
[node name="MasterHBox" type="HBoxContainer" parent="VBoxContainer/TabContainer/Audio"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 48)
alignment = 1
