; load_steps=5：1个外部脚本资源 + 3个子资源（Tab面板样式框 + 复选框样式框x2） + 场景本身
[gd_scene load_steps=5 format=3 uid="uid://bsettings"]

; ==============================================================================
; Settings.tscn - 设置界面（美化+居中版）
; 职责：定义游戏设置界面，包含游戏玩法、音频、视频、语言等设置选项
; 所属脚本：Settings.gd (根节点) - 设置控制器，处理设置加载/保存、界面交互等
;
; 美化设计说明：
;   1. 所有Tab页的设置行统一使用 SHRINK_CENTER + 固定最小宽度(820px)，
;      确保在1920x1280或任意分辨率下，设置项始终水平居中而非贴在左边。
;   2. 每行内：Label固定260px + 右对齐 + 中间间隔20px + 控件，
;      下拉框/滑块 expand/fill 延伸到行尾；复选框行 alignment=0 靠左排列，
;      复选框固定36px紧跟标签——所有控件左边缘统一对齐，视觉上整齐划一。
;   3. Tab页VBox：vertical separation = 22，上下spacer 40/50，
;      行之间留出足够呼吸空间，避免全部挤在一起。
;   4. 分区标题使用 HeaderSmall + 下方 16px spacer，与设置项拉开层次。
;   5. 按钮区域 separation=20，每个按钮左右padding，尺寸均匀。
;   6. 配色三层递进：页面背景(0.13,0.16,0.26) → Tab面板(0.17,0.2,0.32)
;      → 复选框底(0.28,0.32,0.46)，亮度逐级提升保证控件清晰可见。
; ==============================================================================

[ext_resource type="Script" path="res://scripts/ui/Settings.gd" id="1_settings"]

; ------------------------------ 样式子资源 ------------------------------
; 配色设计说明：
;   页面背景 (0.13,0.16,0.26) 深蓝灰 → Tab面板 (0.17,0.2,0.32) → 复选框底 (0.28,0.32,0.46)
;   三层亮度逐级递增，每层都有清晰的对比度，任何控件都不会"沉"进背景里。

; SBTabPanel - Tab内容区面板样式（比背景亮一档的深蓝灰 + 圆角，让Tab页区域从背景中浮现出来）
[sub_resource type="StyleBoxFlat" id="SBTabPanel"]
bg_color = Color(0.17, 0.2, 0.32, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

; SBCheckBoxNormal - 复选框默认态样式（亮底色+高亮描边，在Tab面板上非常醒目）
[sub_resource type="StyleBoxFlat" id="SBCheckBoxNormal"]
bg_color = Color(0.28, 0.32, 0.46, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.85, 0.9, 1.0, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

; SBCheckBoxHover - 复选框悬停/按下态样式（更亮的底色+纯白描边，提供明确的悬停反馈）
[sub_resource type="StyleBoxFlat" id="SBCheckBoxHover"]
bg_color = Color(0.34, 0.38, 0.54, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1.0, 1.0, 1.0, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

; ------------------------------ 根节点 ------------------------------
; Settings (Control) - 设置界面根节点
; anchors_preset=15：全屏锚定
; mouse_filter=2（MOUSE_FILTER_PASS）：先处理自身输入，再传递给子节点按钮
[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_settings")

; ------------------------------ 背景 ------------------------------
; Background (ColorRect) - 设置背景
; 颜色：深蓝灰 (0.13, 0.16, 0.26, 1)——比纯黑亮、带蓝调，
;       与Tab面板(0.17,0.2,0.32)形成层次，避免控件沉入近黑色背景
; mouse_filter=2（MOUSE_FILTER_IGNORE）：不接收鼠标事件，事件穿透到按钮
[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.13, 0.16, 0.26, 1)

; ------------------------------ 主布局 ------------------------------
; VBoxContainer - 主垂直布局容器
; anchors_preset=15 全屏填充，使用 size_flags_vertical=3 让 TabContainer 占满中间区域
; mouse_filter=2（MOUSE_FILTER_IGNORE）：不接收鼠标事件，事件穿透到子按钮
[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 20

; Title (Label) - 设置标题
; 字体大小52，居中显示，顶部留出 40px 间距
; TopSpacer - 主标题上方留白（高30px，mouse_filter=2不拦截鼠标）
[node name="TopSpacer" type="Control" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 30)
mouse_filter = 2

; Title (Label) - "Settings" 主标题（HeaderMedium变体，字号52，水平居中）
[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Settings"
horizontal_alignment = 1
theme_type_variation = &"HeaderMedium"
theme_override_font_sizes/font_size = 52
theme_override_colors/font_color = Color(1.0, 1.0, 1.0, 1.0)

; TabContainer - 标签页容器
; size_flags_vertical=3：垂直方向填充剩余空间
; tab_alignment=1：Tab标签（游戏玩法/音频/视频/语言）水平居中显示，不再靠左
; 字体28：Tab标签文字加大，在1920x1280分辨率下更清晰易读
; panel样式覆盖：Tab内容区使用更亮的圆角面板，与页面背景形成层次
[node name="TabContainer" type="TabContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
tab_alignment = 1
theme_override_styles/panel = SubResource("SBTabPanel")
theme_override_font_sizes/font_size = 28

; ==============================================================================
; ------------------------------ 游戏玩法设置 ------------------------------
; Gameplay (VBoxContainer) - 游戏玩法设置标签页
;   separation=22 行间距 + 上下spacer → 避免设置项挤在一起
; ==============================================================================
[node name="Gameplay" type="VBoxContainer" parent="VBoxContainer/TabContainer"]
layout_mode = 2
theme_override_constants/separation = 22
mouse_filter = 2

; TopSpacer - Tab页顶部留白（30px，四个Tab页格式统一）
[node name="TopSpacer" type="Control" parent="VBoxContainer/TabContainer/Gameplay"]
layout_mode = 2
custom_minimum_size = Vector2(0, 30)
mouse_filter = 2

; 分区标题：居中 + 固定最大宽度，与设置行对齐
[node name="GameplayTitle" type="Label" parent="VBoxContainer/TabContainer/Gameplay"]
layout_mode = 2
text = "Gameplay Settings"
horizontal_alignment = 1
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 0)
theme_type_variation = &"HeaderSmall"
theme_override_font_sizes/font_size = 28

; TitleSpacer - 分区标题与设置行之间的间距（10px，四个Tab页格式统一）
[node name="TitleSpacer" type="Control" parent="VBoxContainer/TabContainer/Gameplay"]
layout_mode = 2
custom_minimum_size = Vector2(0, 10)
mouse_filter = 2

; DifficultyRow - 难度选择行
; size_flags_horizontal=4 (SHRINK_CENTER) + min 820px 水平居中
; 内部 label 右对齐固定260px + separation=20 + option expand fill
[node name="DifficultyHBox" type="HBoxContainer" parent="VBoxContainer/TabContainer/Gameplay"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 48)
alignment = 1
theme_override_constants/separation = 20

[node name="DifficultyLabel" type="Label" parent="VBoxContainer/TabContainer/Gameplay/DifficultyHBox"]
layout_mode = 2
text = "Difficulty:"
horizontal_alignment = 2
vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; DifficultyOption - 难度下拉框（expand填充，选项由Settings.gd用翻译后的难度名填充）
; 字体20：下拉框文字加大，与放大后的标签匹配
[node name="DifficultyOption" type="OptionButton" parent="VBoxContainer/TabContainer/Gameplay/DifficultyHBox"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 40)
theme_override_font_sizes/font_size = 20

; FPSRow - FPS显示开关行
; alignment=0(BEGIN)：内容靠左排列——标签固定在行首（与其它行标签对齐），
; 复选框固定36px紧跟标签，控件左边缘与下拉框/滑块行的左边缘完全一致
[node name="FPSHBox" type="HBoxContainer" parent="VBoxContainer/TabContainer/Gameplay"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 48)
alignment = 0
theme_override_constants/separation = 20

[node name="FPSLabel" type="Label" parent="VBoxContainer/TabContainer/Gameplay/FPSHBox"]
layout_mode = 2
text = "Show FPS Counter:"
horizontal_alignment = 2
vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; FPSCheck - FPS显示复选框（勾选后HUD启动时动态创建FPS标签）
; size_flags_horizontal=0(SHRINK_BEGIN)：固定尺寸紧跟标签右侧，不参与填充/居中，
;   与同行的下拉框/滑块左边缘对齐，整行视觉统一
; custom_minimum_size=36x40：固定勾选框尺寸，让样式边框刚好包住勾选图标
; 样式覆盖：normal=默认态可见边框，hover/pressed=悬停态高亮边框（解决默认图标被背景吞掉的问题）
[node name="FPSCheck" type="CheckBox" parent="VBoxContainer/TabContainer/Gameplay/FPSHBox"]
layout_mode = 2
size_flags_horizontal = 0
custom_minimum_size = Vector2(36, 40)
theme_override_styles/normal = SubResource("SBCheckBoxNormal")
theme_override_styles/hover = SubResource("SBCheckBoxHover")
theme_override_styles/pressed = SubResource("SBCheckBoxHover")
theme_override_styles/hover_pressed = SubResource("SBCheckBoxHover")
theme_override_font_sizes/font_size = 22

; AutoShootRow - 自动射击开关行
; alignment=0(BEGIN)：内容靠左排列，与FPS行格式统一
[node name="AutoShootHBox" type="HBoxContainer" parent="VBoxContainer/TabContainer/Gameplay"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 48)
alignment = 0
theme_override_constants/separation = 20

[node name="AutoShootLabel" type="Label" parent="VBoxContainer/TabContainer/Gameplay/AutoShootHBox"]
layout_mode = 2
text = "Auto Shoot:"
horizontal_alignment = 2
vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; AutoShootCheck - 自动射击复选框（默认勾选，应用后实时同步Player.set_auto_shoot）
; 样式与布局说明同FPSCheck：固定尺寸紧跟标签 + 可见边框样式
[node name="AutoShootCheck" type="CheckBox" parent="VBoxContainer/TabContainer/Gameplay/AutoShootHBox"]
layout_mode = 2
size_flags_horizontal = 0
custom_minimum_size = Vector2(36, 40)
pressed = true
theme_override_styles/normal = SubResource("SBCheckBoxNormal")
theme_override_styles/hover = SubResource("SBCheckBoxHover")
theme_override_styles/pressed = SubResource("SBCheckBoxHover")
theme_override_styles/hover_pressed = SubResource("SBCheckBoxHover")
theme_override_font_sizes/font_size = 22

; BottomSpacer - Tab页底部弹性留白（size_flags_vertical=3撑满剩余空间，让设置行靠上聚拢）
[node name="BottomSpacer" type="Control" parent="VBoxContainer/TabContainer/Gameplay"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

