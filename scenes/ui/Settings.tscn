; HintLabel - 操作提示行（手柄/键盘引导）
; 摆放位置：TabContainer 与底部按钮之间，属固定高度区，不参与弹性填充
; 字体18 + 淡蓝灰配色：作为引导信息存在感低于正文标签，不与设置项抢视觉重心
; 文本由 Settings.gd._update_text() 通过 TranslationManager 填充（支持中英切换）
[node name="HintLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "LT / RT 切换分类 · 方向键选择 · 左右调节数值 · A 确认 · B 返回"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.6, 0.7, 0.85, 1)

; ==============================================================================
; ------------------------------ 按钮区域 ------------------------------
; ButtonSpacer - 按钮区上方间距（固定10px）
; 【关键】按钮区全部为固定高度，不做弹性填充，保证任何窗口高度下都可见
; ==============================================================================
[node name="ButtonSpacer" type="Control" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 10)
mouse_filter = 2

; ButtonContainer - 底部操作按钮行（SHRINK_CENTER + 最小900px水平居中，间隔24px）
[node name="ButtonContainer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(900, 0)
theme_override_constants/separation = 24

; BackButton - 返回按钮（发出go_back信号，由Main.gd决定返回主菜单还是暂停菜单）
; 样式：统一按钮底色 + 亮青焦点框（手柄聚焦时一眼可见）
[node name="BackButton" type="Button" parent="VBoxContainer/ButtonContainer"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 48)
text = "Back"
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("SBButtonNormal")
theme_override_styles/hover = SubResource("SBButtonHover")
theme_override_styles/pressed = SubResource("SBButtonPressed")
theme_override_styles/focus = SubResource("SBFocusBorder")

; ResetButton - 恢复默认按钮（仅重置UI与音量，需再点Apply才写入配置文件）
