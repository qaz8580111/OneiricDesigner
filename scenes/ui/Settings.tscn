; load_steps=12：1个外部脚本资源 + 10个子资源（Tab面板 + 复选框x2 + 滑块x3 + 按钮x3 + 通用焦点框）
;                + 场景本身
[gd_scene load_steps=12 format=3 uid="uid://bsettings"]

; ==============================================================================
; Settings.tscn - 设置界面（居中 + 可滚动版）
; 职责：定义游戏设置界面，包含游戏玩法、音频、视频、语言等设置选项
; 所属脚本：Settings.gd (根节点) - 设置控制器，处理设置加载/保存、界面交互等
;
; 布局设计说明：
;   1. 每个Tab页内容外包一层 ScrollContainer：设置行总高超过Tab可视高度时在页内滚动，
;      而不是把底部按钮挤出窗口——修复"切换到较低分辨率后应用按钮消失"的问题。
;      ScrollContainer 不向父级传递子节点最小尺寸，故 TabContainer 高度始终稳定。
;      scroll 内容用 VBoxContainer 且不设纵向 EXPAND，纵向撑满会导致永不触发滚动。
;   2. follow_focus=true：手柄/键盘把焦点移到不可见行时，自动滚动使其进入视野。
;   3. 所有Tab页的设置行统一使用 SHRINK_CENTER + 固定最小宽度(820px)，
;      确保在1920x1280或任意分辨率下，设置项始终水平居中而非贴在左边。
;   4. 每行内：Label固定260px + 右对齐 + 中间间隔20px + 控件，
;      下拉框/滑块 expand/fill 延伸到行尾；复选框行 alignment=0 靠左排列，
;      复选框固定36px紧跟标签——所有控件左边缘统一对齐，视觉上整齐划一。
;   5. 字号层级：主标题46 / Tab标签24 / 分区标题26 / 行标签22 / 下拉20，
;      逐级递减，层次清楚且在大分辨率下不显臃肿。
;   6. 配色三层递进：页面背景(0.13,0.16,0.26) → Tab面板(0.17,0.2,0.32)
;      → 复选框底(0.28,0.32,0.46)；分区标题用淡蓝(0.72,0.86,1.0)与白色行标签区分层级。
; ==============================================================================

[ext_resource type="Script" path="res://scripts/ui/Settings.gd" id="1_settings"]

; ------------------------------ 样式子资源 ------------------------------
; 配色设计说明：
;   页面背景 (0.13,0.16,0.26) 深蓝灰 → Tab面板 (0.17,0.2,0.32) → 复选框底 (0.28,0.32,0.46)
;   三层亮度逐级递增，每层都有清晰的对比度，任何控件都不会"沉"进背景里。

; SBTabPanel - Tab内容区面板样式（比背景亮一档的深蓝灰 + 圆角，让Tab页区域从背景中浮现出来）
[sub_resource type="StyleBoxFlat" id="SBTabPanel"]
bg_color = Color(0.17, 0.2, 0.32, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

; SBCheckBoxNormal - 复选框默认态样式（亮底色+高亮描边，在Tab面板上非常醒目）
[sub_resource type="StyleBoxFlat" id="SBCheckBoxNormal"]
bg_color = Color(0.28, 0.32, 0.46, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.85, 0.9, 1.0, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

; SBCheckBoxHover - 复选框悬停/按下态样式（更亮的底色+纯白描边，提供明确的悬停反馈）
[sub_resource type="StyleBoxFlat" id="SBCheckBoxHover"]
bg_color = Color(0.34, 0.38, 0.54, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1.0, 1.0, 1.0, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

; ↓↓↓ 滑块（HSlider）样式组：解决"手柄聚焦滑块时看不出焦点、调节手感差"的问题 ↓↓↓
; 说明：Slider::get_minimum_size() 取 max(轨道样式高, grabber图标高)，轨道高度由
;       StyleBoxFlat 的 content_margin_top/bottom 共同撑出（上下各8 → 轨道16px，圆角8成胶囊形）。
;       三个样式必须用完全相同的 content_margin，否则"已填充条"与"轨道"会错位。

; SBSliderTrack - 滑块轨道（凹槽）：比Tab面板更深的底色，与亮色填充形成强对比
[sub_resource type="StyleBoxFlat" id="SBSliderTrack"]
content_margin_top = 8.0
content_margin_bottom = 8.0
bg_color = Color(0.1, 0.13, 0.22, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

; SBSliderFill - 滑块已填充部分（正常态）：亮蓝，明确指示当前数值位置
[sub_resource type="StyleBoxFlat" id="SBSliderFill"]
content_margin_top = 8.0
content_margin_bottom = 8.0
bg_color = Color(0.35, 0.7, 1.0, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

; SBSliderFillHL - 滑块已填充部分（悬停/手柄聚焦态）：更亮的青蓝 + 白描边，
; 手柄用摇杆/十字键选中滑块时整条填充会明显发亮，玩家一眼可见当前焦点
[sub_resource type="StyleBoxFlat" id="SBSliderFillHL"]
content_margin_top = 8.0
content_margin_bottom = 8.0
bg_color = Color(0.62, 0.93, 1.0, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 1, 1, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

; ↓↓↓ 按钮 / 复选框焦点样式组：手柄导航时焦点必须一眼可辨 ↓↓↓

; SBButtonNormal - 底部操作按钮默认态（比Tab面板亮一档的蓝灰 + 细描边）
[sub_resource type="StyleBoxFlat" id="SBButtonNormal"]
content_margin_left = 16.0
content_margin_right = 16.0
bg_color = Color(0.24, 0.28, 0.42, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.42, 0.48, 0.64, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

; SBButtonHover - 按钮悬停态（更亮底色 + 明显描边）
[sub_resource type="StyleBoxFlat" id="SBButtonHover"]
content_margin_left = 16.0
content_margin_right = 16.0
bg_color = Color(0.33, 0.39, 0.56, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.62, 0.72, 0.92, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

; SBButtonPressed - 按钮按下态（压暗，提供明确的触感反馈）
[sub_resource type="StyleBoxFlat" id="SBButtonPressed"]
content_margin_left = 16.0
content_margin_right = 16.0
bg_color = Color(0.16, 0.19, 0.3, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.5, 0.6, 0.8, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

; SBFocusBorder - 通用焦点框（仅描边不填充，复用给按钮与复选框）
; 手柄/键盘把焦点移到某控件时，该亮青色描边即刻出现，解决"看不出焦点在哪"的问题
[sub_resource type="StyleBoxFlat" id="SBFocusBorder"]
draw_center = false
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.62, 0.93, 1.0, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

; ------------------------------ 根节点 ------------------------------
; Settings (Control) - 设置界面根节点
; anchors_preset=15：全屏锚定
; mouse_filter=2（MOUSE_FILTER_PASS）：先处理自身输入，再传递给子节点按钮
[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_settings")

; ------------------------------ 背景 ------------------------------
; Background (ColorRect) - 设置背景
; 颜色：深蓝灰 (0.13, 0.16, 0.26, 1)——比纯黑亮、带蓝调，
;       与Tab面板(0.17,0.2,0.32)形成层次，避免控件沉入近黑色背景
; mouse_filter=2（MOUSE_FILTER_IGNORE）：不接收鼠标事件，事件穿透到按钮
[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.13, 0.16, 0.26, 1)

; ------------------------------ 主布局 ------------------------------
; VBoxContainer - 主垂直布局容器
; anchors_preset=15 全屏填充；TabContainer 用 size_flags_vertical=3 占满中间剩余空间
; 【关键】底部按钮区在VBox内固定高度（非弹性），上下留白均为固定值，
;        因此窗口再矮也只会压缩TabContainer，按钮永远保留在可视区内
; mouse_filter=2（MOUSE_FILTER_IGNORE）：不接收鼠标事件，事件穿透到子按钮
[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 18

; TopSpacer - 主标题上方留白（高24px，mouse_filter=2不拦截鼠标）
[node name="TopSpacer" type="Control" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 24)
mouse_filter = 2

; Title (Label) - "Settings" 主标题（字号46，水平居中）
; 不用 theme_type_variation：项目未定义 HeaderMedium 主题变体，写了也无效，
; 字号完全由下面的 font_size 覆盖决定（避免误导后续维护者）
[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Settings"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 46
theme_override_colors/font_color = Color(1.0, 1.0, 1.0, 1.0)

; TabContainer - 标签页容器
; size_flags_vertical=3：垂直方向填充VBox中的剩余空间（内容溢出由页内ScrollContainer消化）
; tab_alignment=1：Tab标签（游戏玩法/音频/视频/语言）水平居中显示，不再靠左
; 字体24：Tab标签清晰易读，又不会挤占过多纵向空间
; panel样式覆盖：Tab内容区使用更亮的圆角面板，与页面背景形成层次
[node name="TabContainer" type="TabContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
tab_alignment = 1
theme_override_styles/panel = SubResource("SBTabPanel")
theme_override_font_sizes/font_size = 24

; ==============================================================================
; ------------------------------ 游戏玩法设置 ------------------------------
; Gameplay (ScrollContainer) - 游戏玩法设置标签页（页内可滚动）
;   horizontal_scroll_mode=0 禁用横向滚动（行宽已固定820居中，无需横滚）
;   follow_focus=true 焦点移出视野时自动滚动跟随（手柄长列表导航必需）
;   PageContent (VBoxContainer)：真正的行容器，separation=22 行间距；
;     不设 size_flags_vertical（纵向撑满会让最小尺寸=父高度，永不触发滚动）
; ==============================================================================
[node name="Gameplay" type="ScrollContainer" parent="VBoxContainer/TabContainer"]
layout_mode = 2
horizontal_scroll_mode = 0
follow_focus = true

[node name="PageContent" type="VBoxContainer" parent="VBoxContainer/TabContainer/Gameplay"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 22
mouse_filter = 2

; TopSpacer - Tab页顶部留白（24px，四个Tab页格式统一）
[node name="TopSpacer" type="Control" parent="VBoxContainer/TabContainer/Gameplay/PageContent"]
layout_mode = 2
custom_minimum_size = Vector2(0, 24)
mouse_filter = 2

; 分区标题：居中 + 固定最大宽度，与设置行对齐；淡蓝色与白色行标签区分层级
[node name="GameplayTitle" type="Label" parent="VBoxContainer/TabContainer/Gameplay/PageContent"]
layout_mode = 2
text = "Gameplay Settings"
horizontal_alignment = 1
vertical_alignment = 1
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 0)
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.72, 0.86, 1.0, 1.0)

; TitleSpacer - 分区标题与设置行之间的间距（8px，四个Tab页格式统一）
[node name="TitleSpacer" type="Control" parent="VBoxContainer/TabContainer/Gameplay/PageContent"]
layout_mode = 2
custom_minimum_size = Vector2(0, 8)
mouse_filter = 2

; DifficultyHBox - 难度选择行
; size_flags_horizontal=4 (SHRINK_CENTER) + min 820px 水平居中
; 内部 label 右对齐固定260px + separation=20 + option expand fill
[node name="DifficultyHBox" type="HBoxContainer" parent="VBoxContainer/TabContainer/Gameplay/PageContent"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 48)
alignment = 1
theme_override_constants/separation = 20

[node name="DifficultyLabel" type="Label" parent="VBoxContainer/TabContainer/Gameplay/PageContent/DifficultyHBox"]
layout_mode = 2
text = "Difficulty:"
horizontal_alignment = 2
vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; DifficultyOption - 难度下拉框（expand填充，选项由Settings.gd用翻译后的难度名填充）
; 字体20：下拉框文字加大，与放大后的标签匹配
; 手柄操作：焦点落在下拉框上时，左右方向键/摇杆就地切换选项（由MenuNavigator驱动）
[node name="DifficultyOption" type="OptionButton" parent="VBoxContainer/TabContainer/Gameplay/PageContent/DifficultyHBox"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 40)
theme_override_styles/focus = SubResource("SBFocusBorder")
theme_override_font_sizes/font_size = 20

; FPSHBox - FPS显示开关行
; alignment=0(BEGIN)：内容靠左排列——标签固定在行首（与其它行标签对齐），
; 复选框固定36px紧跟标签，控件左边缘与下拉框/滑块行的左边缘完全一致
[node name="FPSHBox" type="HBoxContainer" parent="VBoxContainer/TabContainer/Gameplay/PageContent"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 48)
alignment = 0
theme_override_constants/separation = 20

[node name="FPSLabel" type="Label" parent="VBoxContainer/TabContainer/Gameplay/PageContent/FPSHBox"]
layout_mode = 2
text = "Show FPS Counter:"
horizontal_alignment = 2
vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; FPSCheck - FPS显示复选框（勾选后HUD启动时动态创建FPS标签）
; size_flags_horizontal=0(SHRINK_BEGIN)：固定尺寸紧跟标签右侧，不参与填充/居中，
;   与同行的下拉框/滑块左边缘对齐，整行视觉统一
; custom_minimum_size=36x40：固定勾选框尺寸，让样式边框刚好包住勾选图标
; 样式覆盖：normal=默认态可见边框，hover/pressed=悬停态高亮边框（解决默认图标被背景吞掉的问题）
[node name="FPSCheck" type="CheckBox" parent="VBoxContainer/TabContainer/Gameplay/PageContent/FPSHBox"]
layout_mode = 2
size_flags_horizontal = 0
custom_minimum_size = Vector2(36, 40)
theme_override_styles/normal = SubResource("SBCheckBoxNormal")
theme_override_styles/hover = SubResource("SBCheckBoxHover")
theme_override_styles/pressed = SubResource("SBCheckBoxHover")
theme_override_styles/hover_pressed = SubResource("SBCheckBoxHover")
theme_override_styles/focus = SubResource("SBFocusBorder")
theme_override_font_sizes/font_size = 22

; AutoShootHBox - 自动射击开关行
; alignment=0(BEGIN)：内容靠左排列，与FPS行格式统一
[node name="AutoShootHBox" type="HBoxContainer" parent="VBoxContainer/TabContainer/Gameplay/PageContent"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 48)
alignment = 0
theme_override_constants/separation = 20

[node name="AutoShootLabel" type="Label" parent="VBoxContainer/TabContainer/Gameplay/PageContent/AutoShootHBox"]
layout_mode = 2
text = "Auto Shoot:"
horizontal_alignment = 2
vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; AutoShootCheck - 自动射击复选框（默认勾选，应用后实时同步Player.set_auto_shoot）
; 样式与布局说明同FPSCheck：固定尺寸紧跟标签 + 可见边框样式
[node name="AutoShootCheck" type="CheckBox" parent="VBoxContainer/TabContainer/Gameplay/PageContent/AutoShootHBox"]
layout_mode = 2
size_flags_horizontal = 0
custom_minimum_size = Vector2(36, 40)
pressed = true
theme_override_styles/normal = SubResource("SBCheckBoxNormal")
theme_override_styles/hover = SubResource("SBCheckBoxHover")
theme_override_styles/pressed = SubResource("SBCheckBoxHover")
theme_override_styles/hover_pressed = SubResource("SBCheckBoxHover")
theme_override_styles/focus = SubResource("SBFocusBorder")
theme_override_font_sizes/font_size = 22

; BottomSpacer - Tab页底部留白（固定24px；内容靠上聚拢，溢出时才由ScrollContainer滚动）
[node name="BottomSpacer" type="Control" parent="VBoxContainer/TabContainer/Gameplay/PageContent"]
layout_mode = 2
custom_minimum_size = Vector2(0, 24)
mouse_filter = 2

; ==============================================================================
; ------------------------------ 音频设置 ------------------------------
; Audio (ScrollContainer) - 音频设置标签页（页内可滚动，结构同Gameplay页）
; ==============================================================================
[node name="Audio" type="ScrollContainer" parent="VBoxContainer/TabContainer"]
layout_mode = 2
horizontal_scroll_mode = 0
follow_focus = true

[node name="PageContent" type="VBoxContainer" parent="VBoxContainer/TabContainer/Audio"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 22
mouse_filter = 2

; TopSpacer - Tab页顶部留白（24px，四个Tab页格式统一）
[node name="TopSpacer" type="Control" parent="VBoxContainer/TabContainer/Audio/PageContent"]
layout_mode = 2
custom_minimum_size = Vector2(0, 24)
mouse_filter = 2

; AudioTitle - "Audio Settings" 分区标题（SHRINK_CENTER + 820px与设置行对齐）
[node name="AudioTitle" type="Label" parent="VBoxContainer/TabContainer/Audio/PageContent"]
layout_mode = 2
text = "Audio Settings"
horizontal_alignment = 1
vertical_alignment = 1
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 0)
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.72, 0.86, 1.0, 1.0)

; TitleSpacer - 分区标题与设置行之间的间距（8px，四个Tab页格式统一）
[node name="TitleSpacer" type="Control" parent="VBoxContainer/TabContainer/Audio/PageContent"]
layout_mode = 2
custom_minimum_size = Vector2(0, 8)
mouse_filter = 2

; MasterHBox - 主音量行（标签 + 滑块 + 数值）
[node name="MasterHBox" type="HBoxContainer" parent="VBoxContainer/TabContainer/Audio/PageContent"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 48)
alignment = 1
theme_override_constants/separation = 20

[node name="MasterLabel" type="Label" parent="VBoxContainer/TabContainer/Audio/PageContent/MasterHBox"]
layout_mode = 2
text = "Master Volume:"
horizontal_alignment = 2
vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; MasterSlider - 主音量滑块（0~100，11个刻度，Settings.gd拖动时实时应用音量）
; step=5：焦点在滑块上时，左右方向键/摇杆按step增减（每按一次±5，20档可调），
;         鼠标拖动同样吸附5步进，与tick_count=11的10格刻度视觉对齐
[node name="MasterSlider" type="HSlider" parent="VBoxContainer/TabContainer/Audio/PageContent/MasterHBox"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 100.0
step = 5.0
value = 80.0
tick_count = 11
ticks_on_borders = true
