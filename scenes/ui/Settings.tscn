vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; MasterSlider - 主音量滑块（0~100，11个刻度，Settings.gd拖动时实时应用音量）
; step=5：手柄D-Pad左右键在焦点滑条上原生按step增减（每按一次±5，20档可调），
;         鼠标拖动同样吸附5步进，与tick_count=11的10格刻度视觉对齐
[node name="MasterSlider" type="HSlider" parent="VBoxContainer/TabContainer/Audio/MasterHBox"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 100.0
step = 5.0
value = 80.0
tick_count = 11
ticks_on_borders = true
custom_minimum_size = Vector2(0, 40)

; MasterValue - 主音量数值显示（青色高亮，脚本实时更新为整数）
[node name="MasterValue" type="Label" parent="VBoxContainer/TabContainer/Audio/MasterHBox"]
layout_mode = 2
text = "80"
horizontal_alignment = 1
vertical_alignment = 1
custom_minimum_size = Vector2(60, 0)
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.5, 0.9, 1.0, 1.0)

