alignment = 0
theme_override_constants/separation = 20

[node name="VSyncLabel" type="Label" parent="VBoxContainer/TabContainer/Video/VSyncHBox"]
layout_mode = 2
text = "V-Sync:"
horizontal_alignment = 2
vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; VSyncCheck - 垂直同步复选框（默认勾选，应用后切换VSYNC_ENABLED/DISABLED）
; 样式与布局说明同FPSCheck：固定尺寸紧跟标签 + 可见边框样式
[node name="VSyncCheck" type="CheckBox" parent="VBoxContainer/TabContainer/Video/VSyncHBox"]
layout_mode = 2
size_flags_horizontal = 0
custom_minimum_size = Vector2(36, 40)
pressed = true
theme_override_styles/normal = SubResource("SBCheckBoxNormal")
theme_override_styles/hover = SubResource("SBCheckBoxHover")
theme_override_styles/pressed = SubResource("SBCheckBoxHover")
theme_override_styles/hover_pressed = SubResource("SBCheckBoxHover")
theme_override_font_sizes/font_size = 22

; BottomSpacer - Tab页底部弹性留白（与Gameplay页格式统一）
[node name="BottomSpacer" type="Control" parent="VBoxContainer/TabContainer/Video"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

; ==============================================================================
; ------------------------------ 语言设置 ------------------------------
; Language (VBoxContainer) - 语言设置标签页
; ==============================================================================
[node name="Language" type="VBoxContainer" parent="VBoxContainer/TabContainer"]
layout_mode = 2
theme_override_constants/separation = 22
mouse_filter = 2

; TopSpacer - Tab页顶部留白（30px，四个Tab页格式统一）
[node name="TopSpacer" type="Control" parent="VBoxContainer/TabContainer/Language"]
layout_mode = 2
custom_minimum_size = Vector2(0, 30)
mouse_filter = 2

; LanguageTitle - "Language Settings" 分区标题（HeaderSmall变体，SHRINK_CENTER + 820px与设置行对齐）
[node name="LanguageTitle" type="Label" parent="VBoxContainer/TabContainer/Language"]
layout_mode = 2
text = "Language Settings"
horizontal_alignment = 1
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 0)
theme_type_variation = &"HeaderSmall"
theme_override_font_sizes/font_size = 28

; TitleSpacer - 分区标题与设置行之间的间距（10px，四个Tab页格式统一）
[node name="TitleSpacer" type="Control" parent="VBoxContainer/TabContainer/Language"]
layout_mode = 2
custom_minimum_size = Vector2(0, 10)
mouse_filter = 2

; LanguageRow - 语言选择行
[node name="LanguageHBox" type="HBoxContainer" parent="VBoxContainer/TabContainer/Language"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(820, 48)
alignment = 1
theme_override_constants/separation = 20

[node name="LanguageLabel" type="Label" parent="VBoxContainer/TabContainer/Language/LanguageHBox"]
layout_mode = 2
text = "Language:"
horizontal_alignment = 2
vertical_alignment = 1
custom_minimum_size = Vector2(260, 0)
theme_override_font_sizes/font_size = 22

; LanguageOption - 语言下拉框（选项显示名由TranslationManager提供，zh_CN/en_US）
; 字体20：下拉框文字加大，与放大后的标签匹配
[node name="LanguageOption" type="OptionButton" parent="VBoxContainer/TabContainer/Language/LanguageHBox"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 40)
theme_override_font_sizes/font_size = 20

; BottomSpacer - Tab页底部弹性留白（与Gameplay页格式统一）
[node name="BottomSpacer" type="Control" parent="VBoxContainer/TabContainer/Language"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

; ==============================================================================
; ------------------------------ 按钮区域 ------------------------------
; ButtonContainer - 按钮水平布局容器
; ==============================================================================
; ButtonSpacer - 按钮区上方间距（10px）
[node name="ButtonSpacer" type="Control" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 10)
mouse_filter = 2

; ButtonContainer - 底部操作按钮行（SHRINK_CENTER + 最小900px水平居中，间隔24px）
[node name="ButtonContainer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(900, 0)
theme_override_constants/separation = 24

; BackButton - 返回按钮（发出go_back信号，由Main.gd决定返回主菜单还是暂停菜单）
[node name="BackButton" type="Button" parent="VBoxContainer/ButtonContainer"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 48)
text = "Back"
theme_override_font_sizes/font_size = 18

; ResetButton - 恢复默认按钮（仅重置UI与音量，需再点Apply才写入配置文件）
[node name="ResetButton" type="Button" parent="VBoxContainer/ButtonContainer"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 48)
text = "Reset to Default"
theme_override_font_sizes/font_size = 18

; ApplyButton - 应用按钮（收集设置→保存cfg→应用到引擎/单例→广播settings_applied信号）
[node name="ApplyButton" type="Button" parent="VBoxContainer/ButtonContainer"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 48)
text = "Apply"
theme_override_font_sizes/font_size = 18

; BottomSpacer - 界面底部收尾留白（30px）
[node name="BottomSpacer" type="Control" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 30)
mouse_filter = 2
