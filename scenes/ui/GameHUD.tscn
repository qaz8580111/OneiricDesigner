[gd_scene load_steps=2 format=3 uid="uid://bhud"]

; ==============================================================================
; GameHUD.tscn - 游戏HUD界面
; 职责：定义游戏进行中的抬头显示，包含血量条、梦境碎片、经验条、等级、难度等信息
; 所属脚本：GameHUD.gd (根节点) - HUD控制器，更新UI显示、响应游戏事件等
;
; 场景结构：
;   GameHUD (Control) - 全屏覆盖
;   ├── HealthBar (ProgressBar) - 血量条（左上角）
;   ├── FragmentLabel (Label) - 梦境碎片数量显示（血量条下方）
;   └── DiffLabel (Label) - 难度等级显示（顶部居中，状态栏下方）
;
; 以下UI由 GameHUD.gd 代码动态创建（不在本场景文件中）：
;   顶部状态栏（时间/击杀/最高连击，顶部居中 y=12，原底部栏上移合并）
;   护盾显示（类型图标+耐久条，左上角 y=84，装备护盾后显示）
;   Buff三行图标区（按稀有度分行从高到低：史诗 y=130 / 稀有 y=172 / 普通 y=214）
;   FPS标签（y=256，settings.cfg 开启 show_fps 后显示）
;
; 使用方式：作为UIStack的子节点动态加载到CanvasLayer中
; ==============================================================================

[ext_resource type="Script" path="res://scripts/ui/GameHUD.gd" id="1"]

; ------------------------------ 根节点 ------------------------------
; GameHUD (Control) - HUD根节点
; anchors_preset=15：全屏锚定，覆盖整个屏幕
; mouse_filter=2（MOUSE_FILTER_IGNORE）：不接收鼠标事件，避免遮挡菜单按钮点击
[node name="GameHUD" type="Control"]
script = ExtResource("1")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 0.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 0.0
mouse_filter = 2

; ------------------------------ 血量显示 ------------------------------
; HealthBar (ProgressBar) - 玩家血量条
; 位置：左上角 (20, 20)，尺寸：200x20
; tint_over=红色：血量部分颜色，tint_under=灰色半透明：背景颜色
[node name="HealthBar" type="ProgressBar" parent="."]
position = Vector2(20, 20)
size = Vector2(200, 20)
max_value = 100.0
value = 100.0
tint_over = Color(1, 0.2, 0.2, 1)
tint_under = Color(0.3, 0.3, 0.3, 0.5)

; ------------------------------ 梦境碎片显示 ------------------------------
; FragmentLabel (Label) - 梦境碎片数量
; 位置：血量条下方 (20, 50)，字体颜色：金色 (1, 0.8, 0, 1)
[node name="FragmentLabel" type="Label" parent="."]
position = Vector2(20, 50)
size = Vector2(200, 20)
text = "梦境碎片: 0"
custom_minimum_size = Vector2(200, 0)
theme_override_colors/font_color = Color(1, 0.8, 0, 1)

; ------------------------------ 难度显示 ------------------------------
; DiffLabel (Label) - 难度等级（随时间提升）
; 位置：顶部居中（状态栏下方44px），随难度升高的警示色由脚本控制
; 说明：右上角仅保留小地图，难度信息与顶部状态栏一并居中展示
[node name="DiffLabel" type="Label" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -60.0
offset_top = 44.0
offset_right = 60.0
offset_bottom = 64.0
grow_horizontal = 2
text = "难度 1"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)