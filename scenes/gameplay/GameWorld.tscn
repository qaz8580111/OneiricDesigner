[gd_scene load_steps=3 format=3 uid="uid://bgameworld"]

; ==============================================================================
; GameWorld.tscn - 游戏世界场景
; 职责：定义游戏世界的根节点，作为所有游戏实体（玩家、敌人、物品）的容器
; 所属脚本：GameWorld.gd (根节点) - 游戏世界管理器，处理敌人生成、场景管理等
;
; 场景结构：
;   GameWorld (Node2D)
;   ├── BgLayer (CanvasLayer, layer=-1) - 背景层（固定屏幕，不随相机移动）
;   │   └── Background (ColorRect) - 游戏背景（深灰蓝色，全屏锚点）
;   └── [动态添加] Player, Enemy, PickUp 等游戏实体
;
; 使用方式：在Main.tscn中作为子节点加载，玩家和敌人通过脚本动态生成到此节点下
; ==============================================================================

[ext_resource type="Script" path="res://scripts/entities/GameWorld.gd" id="1_world"]
[ext_resource type="BulletData" path="res://data/bullet/player_default_bullet.tres" id="2_playerbullet"]

; ------------------------------ 根节点 ------------------------------
; GameWorld (Node2D) - 游戏世界根节点
; 作为所有游戏实体的父容器，提供统一的坐标空间
; default_bullet_data: 玩家发射子弹的默认配置（引用资源文件）
[node name="GameWorld" type="Node2D"]
script = ExtResource("1_world")
default_bullet_data = ExtResource("2_playerbullet")

; ------------------------------ 背景 ------------------------------
; BgLayer (CanvasLayer) - 背景层
; layer=-1：绘制在游戏世界之下；CanvasLayer不随相机移动，
; 背景永远铺满屏幕（玩家移动到任何位置都不会露出默认清屏色）
; 注意：project.godot 的 default_clear_color 与本背景同色(0.1,0.1,0.15)，
; 双重保证世界无限大时看不到任何背景色分界；若修改背景色需同步修改清屏色
[node name="BgLayer" type="CanvasLayer" parent="."]
layer = -1

; Background (ColorRect) - 游戏背景
; 颜色：深灰蓝 (0.1, 0.1, 0.15, 1)，营造梦境氛围
; 全屏锚点（anchors_preset=15）：相对视口自适应，任意分辨率下都铺满
[node name="Background" type="ColorRect" parent="BgLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.1, 0.15, 1)