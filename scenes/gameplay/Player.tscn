[gd_scene load_steps=6 format=3]

; ==============================================================================
; Player.tscn - 玩家角色场景
; 职责：定义玩家角色的完整节点结构，包含碰撞体、精灵、相机、健康系统等
; 所属脚本：
;   - Player.gd (根节点) - 玩家控制器，处理移动、射击等核心逻辑
;   - PlayerHealthController.gd (HealthController) - 健康系统协调器
;   - ShieldComponent.gd (ShieldComponent) - 护盾组件，管理护盾段数和恢复
;   - CoreHealthComponent.gd (CoreHealthComponent) - 核心血量组件，管理血量和无敌帧
;
; 场景结构：
;   Player (CharacterBody2D)
;   ├── Sprite2D - 玩家外观显示（蓝色方块）
;   ├── CollisionShape2D - 玩家物理碰撞体（半径20）
;   ├── Hitbox (Area2D) - 伤害检测区域（半径18，略小于物理碰撞体）
;   │   └── CollisionShape2D
;   ├── Camera2D - 跟随玩家的相机（平滑跟随）
;   └── HealthController (Node) - 健康系统容器
;       ├── ShieldComponent (Node) - 护盾组件
;       │   ├── RegenDelayTimer (Timer) - 护盾恢复延迟计时器（5秒）
;       │   └── RegenTimer (Timer) - 护盾恢复计时器（1.5秒）
;       └── CoreHealthComponent (Node) - 核心血量组件
;           └── InvincibleTimer (Timer) - 无敌帧计时器（0.5秒）
;
; 碰撞层配置：
;   - Player (CharacterBody2D): collision_layer=1, collision_mask=1
;   - Hitbox (Area2D): collision_mask=1（只检测与玩家层的碰撞）
; ==============================================================================

[ext_resource type="Script" path="res://scripts/entities/Player.gd" id="1_player"]
[ext_resource type="Script" path="res://scripts/components/PlayerHealthController.gd" id="2_controller"]
[ext_resource type="Script" path="res://scripts/components/ShieldComponent.gd" id="3_shield"]
[ext_resource type="Script" path="res://scripts/components/CoreHealthComponent.gd" id="4_core"]

; 物理碰撞体形状 - 用于角色移动和碰撞检测（半径20像素）
[sub_resource type="CircleShape2D" id="CircleShape2D_1"]
radius = 20.0

; 伤害检测碰撞体形状 - 略小于物理碰撞体（半径18像素），提供更精确的受击判定
[sub_resource type="CircleShape2D" id="CircleShape2D_2"]
radius = 18.0

; ------------------------------ 根节点 ------------------------------
; Player (CharacterBody2D) - 玩家物理角色根节点
; 碰撞层：1（玩家层），碰撞掩码：1+2（检测玩家层和敌人层，实现物理碰撞排斥）
; 所属组：player（用于查找玩家引用）
[node name="Player" type="CharacterBody2D"]
script = ExtResource("1_player")
collision_layer = 1
collision_mask = 3
groups = PackedStringArray("player")

; ------------------------------ 外观与碰撞 ------------------------------
; Sprite2D - 玩家外观显示
; 颜色：蓝色 (0, 0.5, 1, 1)，用于区分玩家与敌人
[node name="Sprite2D" type="Sprite2D" parent="."]
modulate = Color(0, 0.5, 1, 1)

; CollisionShape2D - 玩家物理碰撞体
; 使用 CircleShape2D_1（半径20），用于角色移动和物理碰撞检测
[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_1")

; Hitbox (Area2D) - 伤害检测区域
; 使用较小的碰撞体（半径18），只检测碰撞掩码（不参与物理碰撞）
; collision_layer=1：设置在玩家层，供敌人子弹检测（area_entered信号）
; collision_mask=8：检测敌人子弹层（Area2D之间需要双方互相检测才能触发area_entered）
[node name="Hitbox" type="Area2D" parent="."]
collision_layer = 1
collision_mask = 8

; CollisionShape2D - 伤害检测碰撞体
; 使用 CircleShape2D_2（半径18），略小于物理碰撞体
[node name="CollisionShape2D" type="CollisionShape2D" parent="Hitbox"]
shape = SubResource("CircleShape2D_2")

; ------------------------------ 相机 ------------------------------
; Camera2D - 跟随玩家的相机
; 设置：平滑跟随启用，平滑速度0.1（较慢的跟随速度，产生流畅的视觉效果）
[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(0, 0)
current = true
smooth_enabled = true
smooth_follow = true
smooth_speed = 0.1

; ------------------------------ 健康系统 ------------------------------
; HealthController (Node) - 健康系统容器
; 负责协调护盾和核心血量组件，提供统一的健康管理接口
[node name="HealthController" type="Node" parent="."]
script = ExtResource("2_controller")

; ShieldComponent (Node) - 护盾组件
; 管理护盾段数、伤害吸收、护盾恢复逻辑
[node name="ShieldComponent" type="Node" parent="HealthController"]
script = ExtResource("3_shield")

; RegenDelayTimer (Timer) - 护盾恢复延迟计时器
; wait_time=5.0：脱战后5秒开始恢复护盾
; one_shot=true：单次触发
[node name="RegenDelayTimer" type="Timer" parent="HealthController/ShieldComponent"]
wait_time = 5.0
one_shot = true

; RegenTimer (Timer) - 护盾恢复计时器
; wait_time=1.5：每1.5秒恢复一段护盾
; one_shot=true：单次触发（恢复一段后需要重新开始）
[node name="RegenTimer" type="Timer" parent="HealthController/ShieldComponent"]
wait_time = 1.5
one_shot = true

; CoreHealthComponent (Node) - 核心血量组件
; 管理核心血量、无敌帧、红血预警、死亡判定
[node name="CoreHealthComponent" type="Node" parent="HealthController"]
script = ExtResource("4_core")

; InvincibleTimer (Timer) - 无敌帧计时器
; wait_time=0.5：受击后0.5秒无敌
; one_shot=true：单次触发
[node name="InvincibleTimer" type="Timer" parent="HealthController/CoreHealthComponent"]
wait_time = 0.5
one_shot = true