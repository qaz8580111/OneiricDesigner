[ext_resource type="Script" path="res://scripts/resources/temple/AttributeBoostTempleOption.gd" id="1"]

[resource]
script = ExtResource("1")
option_id = "attribute_boost"
display_name = "强化属性"
description = "随机选中一个已拥有的属性类词条，等级 +1 级，可突破5级上限。只针对属性类，不包含技能类。强化目标随机——可能点到关键属性，也可能点到次要属性。每次消耗梦境碎片，且消耗逐次累加。"
option_color = Color(0.35, 1.0, 0.55, 1)
is_gamble = true
