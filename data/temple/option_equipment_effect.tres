[ext_resource type="Script" path="res://scripts/resources/temple/EquipmentEffectTempleOption.gd" id="1"]

[resource]
script = ExtResource("1")
option_id = "equipment_effect"
display_name = "强化装备特效"
description = "随机选中一件已穿戴装备上的一个特效，叠层 +1 层。强化目标随机——可能点到关键史诗特效（血赚），也可能点到鸡肋特效（血亏）。每次消耗梦境碎片，且消耗逐次累加。"
option_color = Color(0.9, 0.55, 0.25, 1)
is_gamble = true
