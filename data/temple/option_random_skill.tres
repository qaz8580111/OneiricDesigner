[gd_resource type="Resource" script_class="RandomSkillTempleOption" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/temple/RandomSkillTempleOption.gd" id="1"]

[resource]
script = ExtResource("1")
option_id = "random_skill"
display_name = "强化技能"
description = "随机选中一个已拥有的技能类词条，等级 +1 级，可突破5级上限且不封顶。只针对技能类，不包含属性类。强化目标随机——可能点到关键史诗技能（血赚），也可能点到鸡肋技能（血亏）。每次消耗梦境碎片，且消耗逐次累加。"
option_color = Color(0.9, 0.55, 0.25, 1)
is_gamble = true
