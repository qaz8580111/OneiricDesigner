[gd_resource type="Resource" script_class="FuseSkillTempleOption" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/temple/FuseSkillTempleOption.gd" id="1"]

[resource]
script = ExtResource("1")
option_id = "fuse_skill"
display_name = "融合技能"
description = "随机融合两个已拥有的技能类词条，效果叠加并释放一个技能格子；融合等级取两技能较高者，且不会被「强化技能」强化。消耗1500梦境碎片（不足时置灰不可选）。玩家仅保留一个融合技能，再次融合替换前一个。"
option_color = Color(1.0, 0.85, 0.2, 1)
is_gamble = true
