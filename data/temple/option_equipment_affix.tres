[ext_resource type="Script" path="res://scripts/resources/temple/EquipmentAffixTempleOption.gd" id="1"]

[resource]
script = ExtResource("1")
option_id = "equipment_affix"
display_name = "强化装备属性"
description = "随机选中一件已穿戴装备上的一条词条，将其数值放大约20%。强化目标随机——可能点到关键装备，也可能点到次要装备。每次消耗梦境碎片，且消耗逐次累加。"
option_color = Color(0.35, 1.0, 0.55, 1)
is_gamble = true
