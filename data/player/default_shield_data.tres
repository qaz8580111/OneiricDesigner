## ==============================================================================
## default_shield_data.tres - 默认护盾配置数据
## 资源类型：ShieldData（护盾数据资源类）
## 所属脚本：ShieldData.gd
## 用途：定义玩家默认护盾属性，在编辑器中创建并配置，运行时加载使用
## ==============================================================================

[gd_resource type="ShieldData" load_steps=1 format=3]

[resource]
## ==================== 基础属性（核心配置） ====================

## 护盾段数上限：3段（玩家最多拥有3段护盾）
max_segments = 3

## 每段护盾吸收伤害值：10.0点（每段护盾可吸收10点伤害）
segment_hp = 10.0

## 脱战后回盾延迟：5.0秒（从最后一次受击开始计时，5秒后开始恢复护盾）
regen_delay = 5.0

## 每段护盾恢复间隔：1.5秒（恢复延迟结束后，每1.5秒恢复一段护盾）
regen_interval = 1.5

## ==================== 表现配置（视觉/音效） ====================

## 碎盾粒子特效：null（暂无特效，可在编辑器中添加PackedScene）
break_vfx = null

## 护盾受击音效：null（暂无音效，可在编辑器中添加AudioStream）
hit_sfx = null

## 满盾颜色：青色（RGB: 0, 1, 1），用于UI显示护盾状态
color_full = Color(0, 1, 1, 1)

## 低护盾颜色：橙色（RGB: 1, 0.666667, 0），仅剩1段时显示警示颜色
color_low = Color(1, 0.666667, 0, 1)