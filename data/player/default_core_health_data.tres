## ==============================================================================
## default_core_health_data.tres - 默认核心血量配置数据
## 资源类型：CoreHealthData（核心血量数据资源类）
## 所属脚本：CoreHealthData.gd
## 用途：定义玩家默认核心血量属性，在编辑器中创建并配置，运行时加载使用
## ==============================================================================

[gd_resource type="CoreHealthData" load_steps=1 format=3]

[resource]
## ==================== 基础属性（核心配置） ====================

## 核心血量上限：100.0点（玩家的总核心血量）
max_hp = 100.0

## 红血预警阈值：0.3（即30%，当血量低于30%时进入红血状态）
critical_threshold = 0.3

## 核心受击后无敌帧时长：0.5秒（受击后短暂无敌，避免连续受击导致瞬间死亡）
invincible_duration = 0.5

## ==================== 表现配置（视觉/音效） ====================

## 死亡特效：null（暂无特效，可在编辑器中添加PackedScene）
death_vfx = null

## 红血警示音效：null（暂无音效，可在编辑器中添加AudioStream）
critical_sfx = null