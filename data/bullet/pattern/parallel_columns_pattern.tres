; ==============================================================================
[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/bullet/pattern/ParallelColumnPattern.gd" id="1"]

[resource type="ParallelColumnPattern" script_class="ParallelColumnPattern"]
script = ExtResource("1")
