[gd_resource type="Resource" script_class="GameTheme" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/resources/skin/GameTheme.gd" id="1_theme"]
[ext_resource type="Script" path="res://scripts/resources/skin/CharacterSkin.gd" id="2_skin"]

; ==============================================================================
; neon_theme.tres - "霓虹梦境"主题包（一键换肤演示主题）
; 风格：赛博霓虹——深紫夜幕 + 亮青/品红/荧光色系
; 用途：验证主题系统一键切换效果（设置 → 游戏性 → 外观主题 → 应用）
;       切换后：全场角色即时换肤 + 世界背景变深紫 + 弹幕/碎片颜色自动跟随
; 主题结构演示：只需给"想区分"的敌人配专属皮肤，其余敌人自动走兜底皮肤
;   （本主题配了 9 个专属 + 兜底品红，覆盖全部 18 种敌人）
; ==============================================================================

; ------------------------------ 玩家皮肤 ------------------------------
; 亮青圆球+白高光（霓虹主角），弹跳轻快
[sub_resource type="Resource" id="skin_player"]
script = ExtResource("2_skin")
skin_id = "neon_player"
shape = "circle"
main_color = Color(0.2, 1, 0.9, 1)
accent_color = Color(0.85, 1, 1, 1)
target_size = Vector2(40, 40)
move_bounce_scale = 0.16
move_bounce_speed = 13.0

; ------------------------------ 敌人兜底皮肤 ------------------------------
; 霓虹品红方形（本主题未单独配置的敌人都用它）
[sub_resource type="Resource" id="skin_enemy_default"]
script = ExtResource("2_skin")
skin_id = "neon_enemy"
shape = "square"
main_color = Color(1, 0.25, 0.75, 1)
accent_color = Color(1, 0.65, 0.9, 1)
target_size = Vector2(30, 30)

; ------------------------------ 代表性敌人专属皮肤 ------------------------------
; 史莱姆：荧光绿果冻
