skin_id = "neon_slime"
shape = "circle"
main_color = Color(0.4, 1, 0.3, 1)
accent_color = Color(0.8, 1, 0.7, 1)
target_size = Vector2(26, 22)
move_bounce_scale = 0.2
move_bounce_speed = 13.0

