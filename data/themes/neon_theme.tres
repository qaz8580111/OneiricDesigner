[gd_resource type="Resource" script_class="GameTheme" load_steps=14 format=3]

[ext_resource type="Script" path="res://scripts/resources/skin/GameTheme.gd" id="1_theme"]
[ext_resource type="Script" path="res://scripts/resources/skin/CharacterSkin.gd" id="2_skin"]
[ext_resource type="SpriteFrames" path="res://assets/art/roles/player_frames.tres" id="3_player_frames"]

; ==============================================================================
; neon_theme.tres - "霓虹梦境"主题包
; 风格：赛博霓虹——深紫夜幕 + 亮青/品红/荧光色系 + 发光描边
; 所有配件颜色用高饱和荧光色强化 cyberpunk 感
; ==============================================================================

; ------------------------------ 玩家皮肤 ------------------------------
; 序列帧模式：与默认主题共用同一套美术资源
[sub_resource type="Resource" id="skin_player"]
script = ExtResource("2_skin")
skin_id = "neon_player"
render_mode = 1
frames = ExtResource("3_player_frames")
target_size = Vector2(40, 40)
flip_with_direction = true

; ------------------------------ 敌人兜底皮肤 ------------------------------
; 霓虹品红方形 + 发光眼镜（赛博小兵）
[sub_resource type="Resource" id="skin_enemy_default"]
script = ExtResource("2_skin")
skin_id = "neon_enemy"
shape = "square"
main_color = Color(1, 0.25, 0.75, 1)
accent_color = Color(1, 0.65, 0.9, 1)
target_size = Vector2(30, 30)
accessory_type = "glasses"
accessory_color = Color(0.05, 0.05, 0.05, 1)
outline_color = Color(0.5, 0.05, 0.4, 0.8)

; ------------------------------ 代表性敌人专属皮肤 ------------------------------

; 史莱姆：荧光绿果冻 + 发光小花 + 荧光触须感
[sub_resource type="Resource" id="skin_slime"]
script = ExtResource("2_skin")
skin_id = "neon_slime"
shape = "circle"
main_color = Color(0.4, 1, 0.3, 1)
accent_color = Color(0.8, 1, 0.7, 1)
target_size = Vector2(26, 22)
move_bounce_scale = 0.2
move_bounce_speed = 13.0
accessory_type = "flower"
accessory_color = Color(1, 0.95, 0.2, 1)
outline_color = Color(0.1, 0.4, 0.05, 0.8)

; 蝙蝠：电光紫小圆 + 荧光兜帽 + 红眼
[sub_resource type="Resource" id="skin_bat"]
script = ExtResource("2_skin")
skin_id = "neon_bat"
shape = "circle"
main_color = Color(0.65, 0.4, 1, 1)
accent_color = Color(0.9, 0.8, 1, 1)
target_size = Vector2(22, 20)
move_bounce_scale = 0.1
move_bounce_speed = 16.0
hat_type = "hood"
hat_color = Color(0.25, 0.05, 0.5, 1)
eye_color = Color(1, 0.1, 0.3, 1)
outline_color = Color(0.3, 0.05, 0.5, 0.9)

; 夜魇：幽蓝幽灵 + 发光触须发 + 荧光围巾
