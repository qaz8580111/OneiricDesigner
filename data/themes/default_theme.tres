; ------------------------------ 主题包本体 ------------------------------
[resource]
script = ExtResource("1_theme")
theme_id = "default"
theme_name = "梦境默认"
player_skin = SubResource("skin_player")
default_enemy_skin = SubResource("skin_enemy_default")
enemy_skins = {
"slime": SubResource("skin_slime"),
"bat": SubResource("skin_bat"),
"goblin": SubResource("skin_goblin"),
"ghoul": SubResource("skin_ghoul"),
"wraith": SubResource("skin_wraith"),
"spider": SubResource("skin_spider"),
"scout": SubResource("skin_scout"),
"archer": SubResource("skin_archer"),
"sniper": SubResource("skin_sniper"),
"hunter": SubResource("skin_hunter"),
"firemage": SubResource("skin_firemage"),
"thundermage": SubResource("skin_thundermage"),
"skeleton": SubResource("skin_skeleton"),
"knight": SubResource("skin_knight"),
"tank": SubResource("skin_tank"),
"bomber": SubResource("skin_bomber"),
"rocketeer": SubResource("skin_rocketeer"),
"elite_001": SubResource("skin_elite")
}
bg_color = Color(0.1, 0.1, 0.15, 1)
