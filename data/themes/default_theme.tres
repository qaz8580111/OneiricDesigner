[gd_resource type="Resource" script_class="GameTheme" load_steps=23 format=3]

[ext_resource type="Script" path="res://scripts/resources/skin/GameTheme.gd" id="1_theme"]
[ext_resource type="Script" path="res://scripts/resources/skin/CharacterSkin.gd" id="2_skin"]

; ==============================================================================
; default_theme.tres - 默认主题包（"梦境默认"）
; 内容：玩家皮肤 + 全部18种敌人皮肤 + 世界背景色
; 配色完全对齐 data/enemy/*.tres 的现有 placeholder_color/placeholder_size，
; 使主题系统上线前后视觉无变化（平滑迁移，老玩家无感）
; 形状沿用 EnemyData 的体型语言：circle=柔软飞行 / diamond=敏捷远程 / square=重装近战
; 制作新主题时复制本文件改名改色即可，无需改任何代码
; ==============================================================================

; ------------------------------ 玩家皮肤 ------------------------------
; 蓝色方块+眼睛（原玩家占位外观：40x40 蓝 (0,0.5,1)）
[sub_resource type="Resource" id="skin_player"]
script = ExtResource("2_skin")
skin_id = "default_player"
shape = "square"
main_color = Color(0, 0.5, 1, 1)
accent_color = Color(0.55, 0.8, 1, 1)
target_size = Vector2(40, 40)
move_bounce_scale = 0.14
move_bounce_speed = 12.0

; ------------------------------ 敌人兜底皮肤 ------------------------------
; 所有未单独配置的敌人用它（与旧默认占位一致：红色方形）
[sub_resource type="Resource" id="skin_enemy_default"]
script = ExtResource("2_skin")
skin_id = "default_enemy"
shape = "square"
main_color = Color(1, 0.2, 0.2, 1)
accent_color = Color(1, 0.55, 0.55, 1)
target_size = Vector2(30, 30)

; ------------------------------ 各敌人专属皮肤（颜色/体型对齐现状） ------------------------------
; 史莱姆：绿圆 Q弹（弹跳幅度/频率调大，果冻感）
[sub_resource type="Resource" id="skin_slime"]
script = ExtResource("2_skin")
skin_id = "default_slime"
shape = "circle"
main_color = Color(0.2, 0.8, 0.3, 1)
accent_color = Color(0.6, 1, 0.65, 1)
target_size = Vector2(26, 22)
move_bounce_scale = 0.2
move_bounce_speed = 13.0

