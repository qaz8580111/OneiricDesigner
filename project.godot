; ===== 右摇杆瞄准（手柄独占，双摇杆射击；键鼠用鼠标瞄准，故无键盘绑定） =====
; game_aim_left=右摇杆水平轴axis=2向左，deadzone≥0.15符合输入架构规范
game_aim_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":0,"axis":2,"axis_value":-1.0,"script":null)
]
}
; game_aim_right=右摇杆水平轴axis=2向右
