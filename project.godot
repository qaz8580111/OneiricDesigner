"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":0,"axis":3,"axis_value":1.0,"script":null)
]
}
; ===== 选择面板切换（用户定制：手柄从D-Pad改为后下方扳机LT/RT，键盘Q/E保留） =====
; game_choice_prev=键盘Q(physical_keycode=81)/手柄LT扳机(轴axis=4按下到1.0，deadzone0.5为半扣阈值，≥0.15符合规范)
