, Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":0,"axis":4,"axis_value":1.0,"script":null)
]
}
; game_choice_next=键盘E(physical_keycode=69)/手柄RT扳机(轴axis=5)
