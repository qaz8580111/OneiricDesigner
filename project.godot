; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OneiricDesigner"
config/description="A procedurally generated roguelike game with mod support"
run/main_scene="res://scenes/core/Main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

InputManager="*res://scripts/autoload/InputManager.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
RandomManager="*res://scripts/autoload/RandomManager.gd"
TranslationManager="*res://scripts/autoload/TranslationManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
RunStats="*res://scripts/autoload/RunStats.gd"
UpgradeManager="*res://scripts/autoload/UpgradeManager.gd"
DifficultyManager="*res://scripts/autoload/DifficultyManager.gd"
ThemeManager="*res://scripts/autoload/ThemeManager.gd"
ComboManager="*res://scripts/autoload/ComboManager.gd"
StageDirector="*res://scripts/autoload/StageDirector.gd"
LiveBridgeManager="*res://scripts/autoload/LiveBridgeManager.gd"
TowerManager="*res://scripts/autoload/TowerManager.gd"
LeaderboardManager="*res://scripts/autoload/LeaderboardManager.gd"

[display]

; 默认分辨率1920x1280（设计基准，UI/竞技场均按此尺寸设计）
window/size/viewport_width=1920
window/size/viewport_height=1280
; 内容等比缩放：canvas_items模式下2D内容按基准分辨率等比缩放，
; 任何窗口尺寸下UI/世界都不再溢出或错位（消除"人物错位/HUD过大/UI不美观"）
window/stretch/mode="canvas_items"
; expand：保持等比不拉伸，并按窗口宽高比扩展可视区域（无黑边，边缘锚定UI自动贴合）
window/stretch/aspect="expand"

[physics]

; 物理插值：2D物理以60Hz运行，开启插值后渲染帧在物理帧之间平滑过渡，
; 消除移动/旋转的抖动感（尤其在高刷新率显示器上效果显著）
common/physics_interpolation=true

[input]

; ui_cancel=ESC(键盘)/B键(手柄)；注意Godot4中START键索引为6，不再绑定到此动作(旧Godot3索引7已失效)
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
